{
  "mcpServers": {
    "roseline": {
      "type": "stdio",
      "command": "dnx",
      "args": ["RoselineMCP", "--yes"],
      "env": {}
    },
    "adr": {
      "type": "stdio",
      "command": "dnx",
      "args": ["AdrMcp", "--yes"],
      "env": { "DOTNET_hostBuilder__reloadConfigOnChange": "false" }
    }
  }
}
